# Sao chép thành .env ở gốc repo (api đọc ../.env khi chạy từ thư mục api/).
APP_ENV=dev
PUBLIC_BASE_URL=http://localhost:8088
ALLOWED_ORIGIN=http://localhost:8088

POSTGRES_USER=fwdflow
POSTGRES_PASSWORD=fwdflow_dev
POSTGRES_DB=fwdflow
DATABASE_URL=postgresql+psycopg://fwdflow:fwdflow_dev@127.0.0.1:15433/fwdflow
DATABASE_URL_TEST=postgresql+psycopg://fwdflow:fwdflow_dev@127.0.0.1:15433/fwdflow_test
# Mật khẩu LOGIN role cho AI #3 (tạo ở migration 0012)
NLQ_OPS_PASSWORD=change-me-ops
NLQ_FINANCE_PASSWORD=change-me-finance

SESSION_COOKIE_NAME=__Host-sid
SESSION_SECRET=change-me-random-64-hex

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=FwdFlow <no-reply@fwdflow.local>
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_API_URL=http://127.0.0.1:8025

# AI
AI_EXTERNAL_ENABLED=true
ANTHROPIC_API_KEY=
LLM_MODE=replay
# Nhà cung cấp LLM: anthropic (Claude, trả phí) hoặc gemini (Google AI Studio, có gói miễn phí; lấy key ở aistudio.google.com/apikey).
# Gói miễn phí của Google có thể dùng dữ liệu gửi lên để cải thiện sản phẩm: chỉ dùng chứng từ mô phỏng.
LLM_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACTION=gemini-2.5-flash
GEMINI_MODEL_HS=gemini-2.5-flash
GEMINI_MODEL_NLQ=gemini-2.5-flash
CLAUDE_MODEL_EXTRACTION=claude-opus-5
CLAUDE_MODEL_HS=claude-opus-5
CLAUDE_MODEL_NLQ=claude-opus-5
AI_DAILY_TOKEN_BUDGET=2000000
FX_USD_VND=25400

# Chỉ dùng cho test / e2e: cố định "hôm nay" (YYYY-MM-DD)
APP_TODAY=

# Mật khẩu chung cho tài khoản demo (scripts/seed_demo.py, e2e); đặt ≥ 10 ký tự trong .env
SEED_PASSWORD=

# AI: mức suy luận, hạn mức token mỗi lần gọi và ngưỡng đối chiếu chứng từ
CLAUDE_EFFORT_EXTRACTION=high
EXTRACTION_MAX_TOKENS=8000
CROSSCHECK_WEIGHT_TOLERANCE=0.005
CONSIGNEE_SIMILARITY_THRESHOLD=0.85

# AI #2 (gợi ý mã HS): model bge-m3 cục bộ, nạp ở luồng nền khi EMBED_PRELOAD=true; HS_TAU là ngưỡng cosine để bỏ qua Claude
EMBED_MODEL_DIR=../models/bge-m3
EMBED_PRELOAD=false
HS_TAU=0.35
